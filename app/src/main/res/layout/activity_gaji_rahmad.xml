<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_page">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/navy"
            android:gravity="center"
            android:padding="16dp"
            android:text="@string/judul_app"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- FORMULIR INPUT -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilNik"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="@string/hint_nik">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNik"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="20" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilNama"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/hint_nama">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNama"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName|textCapWords"
                android:maxLength="50" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilGajiPokok"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/hint_gaji_pokok">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etGajiPokok"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="12" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilTunjanganJabatan"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/hint_tunjangan_jabatan">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTunjanganJabatan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="12" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilHariKerja"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/hint_hari_kerja">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etHariKerja"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="3" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHitung"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="@string/btn_hitung"
                android:textStyle="bold"
                app:backgroundTint="@color/navy"
                app:cornerRadius="28dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReset"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="@string/btn_reset"
                android:textColor="@color/navy"
                android:textStyle="bold"
                app:cornerRadius="28dp"
                app:strokeColor="@color/navy" />
        </LinearLayout>

        <!-- KARTU HASIL (awalnya disembunyikan) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardHasil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:visibility="gone"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/judul_hasil"
                    android:textColor="@color/navy"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHasilNik"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:textColor="@color/text_muted" />
                <TextView
                    android:id="@+id/tvHasilNama"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp" android:textColor="@color/text_muted" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:text="Tunjangan Makan"
                    android:textColor="@color/text_muted" android:textSize="12sp" />
                <TextView android:id="@+id/tvTunjanganMakan"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:background="@drawable/bg_hasil_row" android:padding="12dp"
                    android:textColor="@color/text_dark" android:textStyle="bold" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:text="Tunjangan Transportasi"
                    android:textColor="@color/text_muted" android:textSize="12sp" />
                <TextView android:id="@+id/tvTunjanganTransport"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:background="@drawable/bg_hasil_row" android:padding="12dp"
                    android:textColor="@color/text_dark" android:textStyle="bold" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:text="Gaji Kotor"
                    android:textColor="@color/text_muted" android:textSize="12sp" />
                <TextView android:id="@+id/tvGajiKotor"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:background="@drawable/bg_hasil_row" android:padding="12dp"
                    android:textColor="@color/text_dark" android:textStyle="bold" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:text="Pajak (10% dari Gaji Kotor)"
                    android:textColor="@color/text_muted" android:textSize="12sp" />
                <TextView android:id="@+id/tvPajak"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:background="@drawable/bg_hasil_row" android:padding="12dp"
                    android:textColor="@color/text_dark" android:textStyle="bold" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:text="Gaji Bersih"
                    android:textColor="@color/text_muted" android:textSize="12sp" />
                <TextView android:id="@+id/tvGajiBersih"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:background="@color/navy" android:padding="14dp"
                    android:textColor="@color/white" android:textSize="18sp" android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKembaliGaji"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/btn_kembali"
            android:textColor="@color/navy" />
    </LinearLayout>
</ScrollView>
